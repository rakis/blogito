---
---

<button
  type="button"
  id="theme-toggle"
  class="theme-toggle-btn"
  aria-label="Toggle theme"
  title="Toggle theme"
>
  <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 17.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11zm0 1.5a7 7 0 1 0 0-14 7 7 0 0 0 0 14zm0-17a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1zm0 18a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0v-1a1 1 0 0 1 1-1zM4.222 4.222a1 1 0 0 1 1.414 0l.707.707a1 1 0 1 1-1.414 1.414l-.707-.707a1 1 0 0 1 0-1.414zm13.435 13.435a1 1 0 0 1 1.414 0l.707.707a1 1 0 0 1-1.414 1.414l-.707-.707a1 1 0 0 1 0-1.414zM2 12a1 1 0 0 1 1-1h1a1 1 0 1 1 0 2H3a1 1 0 0 1-1-1zm18 0a1 1 0 0 1 1-1h1a1 1 0 1 1 0 2h-1a1 1 0 0 1-1-1zM4.222 19.778a1 1 0 0 1 0-1.414l.707-.707a1 1 0 1 1 1.414 1.414l-.707.707a1 1 0 0 1-1.414 0zm13.435-13.435a1 1 0 0 1 0-1.414l.707-.707a1 1 0 1 1 1.414 1.414l-.707.707a1 1 0 0 1-1.414 0z" />
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
    <path fill-rule="evenodd" clip-rule="evenodd" d="M12.315 2c.4 0 .723.31.75.709.145 2.18.997 4.218 2.434 5.807a10.038 10.038 0 0 0 6.223 3.32.75.75 0 0 1 .494 1.155A10.016 10.016 0 0 1 14 21.921a10.01 10.01 0 0 1-8.5-4.717A10.014 10.014 0 0 1 4.079 8.7 10.03 10.03 0 0 1 11.606 2.06c.238-.04.475-.06.709-.06zm-1.07 1.545A8.527 8.527 0 0 0 5.568 8.97a8.513 8.513 0 0 0 1.25 7.234 8.51 8.51 0 0 0 7.225 4.01c2.404 0 4.58-.99 6.136-2.585a11.516 11.516 0 0 1-5.836-3.876 11.545 11.545 0 0 1-2.924-6.38 8.583 8.583 0 0 0-.174-3.828z" />
  </svg>
</button>

<style>
  /* By default in light mode, show moon (to switch to dark) */
  .icon-sun {
    display: none;
  }
  .icon-moon {
    display: block;
  }

  /* When system prefers dark, show sun (to switch to light) */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .icon-sun {
      display: block;
    }
    :root:not([data-theme="light"]) .icon-moon {
      display: none;
    }
  }

  /* When explicitly set to dark, show sun */
  :root[data-theme="dark"] .icon-sun {
    display: block !important;
  }
  :root[data-theme="dark"] .icon-moon {
    display: none !important;
  }

  /* When explicitly set to light, show moon */
  :root[data-theme="light"] .icon-sun {
    display: none !important;
  }
  :root[data-theme="light"] .icon-moon {
    display: block !important;
  }
</style>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const isDark =
        document.documentElement.dataset.theme === 'dark' ||
        (!document.documentElement.dataset.theme &&
          window.matchMedia('(prefers-color-scheme: dark)').matches);

      const targetTheme = isDark ? 'light' : 'dark';
      document.documentElement.dataset.theme = targetTheme;
      localStorage.setItem('theme', targetTheme);

      const meta = document.querySelector('meta[name="color-scheme"]');
      if (meta) {
        meta.setAttribute('content', targetTheme);
      }
    });
  }

  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>
