---
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-container">
    <a href="/" class="site-title">blogito</a>
    <nav class="site-nav" aria-label="Main Navigation">
      <a href="/" class={`nav-link ${currentPath === '/' ? 'active' : ''}`}>Home</a>
      <a href="/categories" class={`nav-link ${currentPath.startsWith('/categories') ? 'active' : ''}`}>Categories</a>
      <a href="/about" class={`nav-link ${currentPath.startsWith('/about') ? 'active' : ''}`}>About</a>
      <ThemeToggle />
    </nav>
  </div>
</header>
